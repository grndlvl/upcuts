{
  "name": "upcuts-brand-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing site concept for UpCuts in Aiken, South Carolina.",
  "scripts": {
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1",
    "lint": "npm run lint:html && npm run lint:css && npm run format:check && npm run check:js && npm run check:xml",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint styles.css",
    "format:check": "prettier --check \"*.{html,css,js,json,md,yml}\" \".github/workflows/*.yml\" \"tests/a11y/**/*.{js,json,yml}\"",
    "format": "prettier --write \"*.{html,css,js,json,md,yml}\" \".github/workflows/*.yml\" \"tests/a11y/**/*.{js,json,yml}\"",
    "check:js": "node --check script.js",
    "check:xml": "xmllint --noout sitemap.xml",
    "a11y": "start-server-and-test serve http://127.0.0.1:4173 a11y:run",
    "a11y:run": "npm run a11y:axe && npm run a11y:pa11y",
    "a11y:axe": "playwright test --config=tests/a11y/playwright.config.js",
    "a11y:pa11y": "pa11y-ci --config tests/a11y/configs/.pa11yci.cjs",
    "a11y:update-snapshots": "playwright test --config=tests/a11y/playwright.config.js --update-snapshots",
    "a11y:doctor": "node tests/a11y/scripts/a11y-doctor.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "html-validate": "^11.5.6",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.5",
    "start-server-and-test": "^3.0.11",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
